{
  "version": "1.3.0",
  "system": {
    "name": "IA-Zar-Proxy",
    "log_level": "INFO",
    "max_threads": 4,
    "use_gpu": false,
    "gpu_id": 0,
    "logging_format": "[%(asctime)s] - %(levelname)s - %(message)s"
  },
  "paths": {
    "model_dir": "iazar/models/",
    "log_dir": "iazar/logs/",
    "data_dir": "iazar/data/",
    "cache_dir": "iazar/cache/",
    "training_dir": "iazar/training/",
    "vmem_dir": "iazar/vmem/"
  },
  "entropy_analysis": {
    "enabled": true,
    "min_entropy": 3.5,
    "min_uniqueness": 0.8,
    "min_zero_density": 0.05,
    "use_entropy_filter": true,
    "log_dropped_nonces": true
  },
  "injection_policy": {
    "mode": "filtered",
    "max_nonces": 512,
    "injection_interval": 2.0,
    "fallback_mode": "raw"
  },
  "model": {
    "type": "joblib",
    "path": "iazar/models/rf_nonce_model.joblib",
    "input_features": [
      "entropy",
      "uniqueness",
      "zero_density",
      "pattern_score"
    ]
  },
  "monitoring": {
    "enable_console_monitor": true,
    "enable_mlflow": false,
    "log_to_file": true,
    "mlflow_config": {
      "tracking_uri": "http://localhost:5000",
      "experiment_name": "IA-Zar"
    }
  },
  "proxy": {
    "host": "127.0.0.1",
    "port": 3333,
    "zmq_enabled": true,
    "zmq_port": 5555,
    "job_poll_interval": 0.1
  },
  "vmem": {
    "enabled": true,
    "vmem_file": "iazar/vmem/nonces.bin",
    "max_blocks": 5000,
    "rotation_enabled": true,
    "rotation_strategy": "fifo"
  },
   "data_paths": {
    "successful_nonces": "iazar/data/nonces_exitosos.csv",
    "nonce_hashes": "iazar/data/nonce_hashes.bin",
    "injected_nonces": "iazar/logs/injected.csv",
    "nonce_training_data_path": "iazar/data/nonce_training_data.csv"
  },
  "processing_params": {
    "temporal_window": 60,
    "entropy_window": 100,
    "candidate_count": 10000,
    "top_candidates": 300,
    "polling_interval": 0.01
  },
  "shared_memory": {
    "name": "zartrux_shared",
    "enabled": true
  }
}